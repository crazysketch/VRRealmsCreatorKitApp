{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VR Realms Creator Kit",
  "mainBinaryName": "VRRealmsCreatorKit",
  "version": "0.4.32",
  "identifier": "com.vrrealms.creatorkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VR Realms Creator Kit",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://vr-realms.com https://*.vr-realms.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Sketchy Realms",
    "copyright": "Copyright (c) 2026 Sketchy Realms. All rights reserved.",
    "licenseFile": "../LICENSE.md",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
